# Copy to .env and fill in ONLY the keys you want to use.
# Nothing here is needed to run the agent: with no keys set it runs
# rule-based on local SQLite. Never commit a real key -- .env is in
# .gitignore.
#
# LLM (optional): enables open-question answers with memories in the
# prompt -- the video's demo loop. Get a key at platform.openai.com.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local model instead (no key needed): Ollama on your machine.
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-4o-mini
# LLM_ENABLED=0  # uncomment to force rule-based mode

# Real Mem0 (optional): mirrors every fact into Mem0.
# Cloud key from app.mem0.ai, or leave unset and install mem0ai for
# the open-source version (needs OPENAI_API_KEY too).
MEM0_API_KEY=
# MEM0_ENABLED=0  # uncomment to disable the Mem0 mirror

# Open-source Mem0 + Qdrant (optional): run `docker compose up -d`
# in this folder, then set QDRANT_HOST so mem0_backend.py uses it.
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
